# Flask App
SECRET_KEY='a_very_secret_key_please_change_this'
# For local SQLite database
DATABASE_URL='sqlite:///app.db'

# Google OAuth Credentials
# Replace with your actual Google Client ID and Secret
# Ensure you have http://127.0.0.1:5000/callback (or your equivalent)
# in your Google Cloud Console authorized redirect URIs.
GOOGLE_CLIENT_ID='YOUR_GOOGLE_CLIENT_ID'
GOOGLE_CLIENT_SECRET='YOUR_GOOGLE_CLIENT_SECRET'

# Set to '1' if running locally with HTTP (not HTTPS) for OAuth callback
# OAUTHLIB_INSECURE_TRANSPORT='1'
